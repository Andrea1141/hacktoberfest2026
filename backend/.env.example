# =====================================================================
# Gluco AI Engine Configuration
# =====================================================================

# Modalità AI:
# - auto: prova prima l'AI locale (Ollama / LM Studio), poi Cloud se disponibile, altrimenti Motore Clinico Offline
# - local: forza l'uso del server AI locale (Ollama, LM Studio, vLLM, llama.cpp)
# - cloud: usa Google Gemini o OpenRouter via API Key
# - offline: usa il simulatore e motore clinico deterministico integrato (100% privacy, zero dipendenze esterne)
AI_PROVIDER=auto

# ---------------------------------------------------------------------
# 1. Configurazione AI Locale (Ollama / LM Studio / LocalAI)
# ---------------------------------------------------------------------
# URL del server Ollama (default: http://localhost:11434) o LM Studio (es. http://localhost:1234/v1)
LOCAL_AI_URL=http://localhost:11434

# Modello testuale locale consigliato (es. gemma2:2b, gemma2:9b, llama3.2:3b, qwen2.5:3b, mistral)
LOCAL_AI_MODEL=gemma2:2b

# Modello multimodale / visione locale per foto pasti (es. llava, llama3.2-vision, moondream)
LOCAL_VISION_MODEL=llava

# ---------------------------------------------------------------------
# 2. Configurazione Cloud (Opzionale - Google AI Studio o OpenRouter)
# ---------------------------------------------------------------------
# Inserisci la tua API Key di Google AI Studio (Gemini / Gemma)
# Ottienila gratuitamente da: https://aistudio.google.com/
GEMINI_API_KEY=

# In alternativa, chiave per OpenRouter
OPENROUTER_API_KEY=

# Modelli cloud di default
GEMMA_GENAI_MODEL=gemini-2.5-flash
GEMMA_OPENROUTER_MODEL=google/gemma-2-9b-it:free
